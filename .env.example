# Copy to .env.local and fill in. .env.local is gitignored.
# In production these go in the hosting provider's environment variables.

# ---------------------------------------------------------------------------
# Public. Sent to the browser. Never put a secret behind a NEXT_PUBLIC_ name.
# ---------------------------------------------------------------------------

# Stripe checkout destination for the buy button. A payment link is a plain
# url and is meant to be public, which is why this one is safe here.
# Stripe dashboard, Payment links.
NEXT_PUBLIC_CHECKOUT_URL=

# ---------------------------------------------------------------------------
# Server only. Both are needed for the automatic download after payment.
# Without them the thanks page still loads and tells the buyer to email you,
# so the manual fallback works whether or not these are set.
# ---------------------------------------------------------------------------

# Restricted key, not the account secret key. The only call made is
# checkout.sessions.retrieve, so Checkout Sessions read is the whole
# permission needed. Stripe dashboard, Developers, API keys.
STRIPE_SECRET_KEY=

# Signs download links. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing it invalidates every link already issued, which is the emergency
# lever if one is ever posted publicly. It must match between local and
# production, or links minted by scripts/mint-link.mjs will be rejected live.
DOWNLOAD_SIGNING_SECRET=
